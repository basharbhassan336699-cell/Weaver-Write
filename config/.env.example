# ═══════════════════════════════════════════════════════════
# Weaver Write — environment (single source of truth for keys)
# Copy to config/.env ; terminal and web UI both read/write this.
# ═══════════════════════════════════════════════════════════

# Your AI API key (one key runs the whole system)
WEAVER_API_KEY=

# Auto-filled from the key's provider (you can override)
WEAVER_BASE_URL=
WEAVER_MODEL=
WEAVER_PROVIDER=

# Generation defaults (optional)
WEAVER_MAX_TOKENS=8000
WEAVER_TEMPERATURE=0.7

# Optional free services (no key)
# SearXNG endpoint for web search. Accepts a LOCAL instance
# (e.g. http://127.0.0.1:8888) or a PUBLIC one. The server MUST allow
# format=json — many public instances disable it, so they won't work here.
# Leave empty to use the built-in default (http://127.0.0.1:8888) then fall
# back to DuckDuckGo automatically.
WEAVER_SEARXNG_URL=
# Extra SearXNG endpoints tried IN ORDER if the primary above fails
# (comma-separated). Each must also support format=json.
WEAVER_SEARXNG_FALLBACKS=
WEAVER_DB=./weaver_memory.db
