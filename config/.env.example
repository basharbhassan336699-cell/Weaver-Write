# ═══════════════════════════════════════════════════════════
# Weaver Write — environment (single source of truth for keys)
# Copy to config/.env ; terminal and web UI both read/write this.
# ═══════════════════════════════════════════════════════════

# Your AI API key (one key runs the whole system)
WEAVER_API_KEY=

# Auto-filled from the key's provider (you can override)
WEAVER_BASE_URL=
WEAVER_MODEL=
WEAVER_PROVIDER=

# Generation defaults (optional)
WEAVER_MAX_TOKENS=8000
WEAVER_TEMPERATURE=0.7

# Optional free services (no key)
WEAVER_SEARXNG_URL=
WEAVER_DB=./weaver_memory.db
